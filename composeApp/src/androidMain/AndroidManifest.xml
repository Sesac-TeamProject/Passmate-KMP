<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR 입장 스캔 (T037) — zxing CaptureActivity가 런타임 권한 요청을 처리한다 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- PTT 힌트 송출 녹음 (M-T2, T121) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
            android:name=".PassmateApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Passmate.Splash">
        <!-- configChanges: 회전으로 액티비티가 재생성되면 installSplashScreen()이 다시 돌아
             스플래시가 또 뜬다. Compose는 설정 변경을 리컴포지션으로 처리하므로 재생성이 필요 없다 -->
        <activity
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection"
                android:exported="true"
                android:launchMode="singleTop"
                android:name="org.sesacteamproject.passmate.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
