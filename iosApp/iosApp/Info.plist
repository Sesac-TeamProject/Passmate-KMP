<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 시안 M-00 스플래시 — 민트 단색 배경 + 가운데 심볼 (라이트·다크 동일) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<!-- 홈 화면에 보이는 이름. 실행 파일명(CFBundleName=Passmate)은 그대로 둔다 -->
	<key>CFBundleDisplayName</key>
	<string>패스메이트</string>
	<key>NSCameraUsageDescription</key>
	<string>방 입장용 QR 코드를 스캔하기 위해 카메라를 사용합니다.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>수업 중 학생들에게 음성 힌트를 보내기 위해 마이크를 사용합니다.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
