<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 시안 M-00 스플래시 — 민트 단색 배경 + 가운데 심볼 (라이트·다크 동일) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<!-- 홈 화면에 보이는 이름. 실행 파일명(CFBundleName=Passmate)은 그대로 둔다 -->
	<key>CFBundleDisplayName</key>
	<string>패스메이트</string>
	<key>NSCameraUsageDescription</key>
	<string>방 입장용 QR 코드를 스캔하기 위해 카메라를 사용합니다.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>수업 중 학생들에게 음성 힌트를 보내기 위해 마이크를 사용합니다.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 실기기에서 맥의 로컬 백엔드에 붙을 때 iOS 14+가 요구한다. 없으면 권한 팝업조차 뜨지 않고 조용히 실패한다 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 네트워크에 있는 개발용 서버에 연결하기 위해 로컬 네트워크를 사용합니다.</string>
	<!-- 백엔드 주소(호스트:포트) — Configuration/Config.xcconfig의 PASSMATE_SERVER_HOST에서 온다 -->
	<key>PassmateServerHost</key>
	<string>$(PASSMATE_SERVER_HOST)</string>
	<!-- 구글 로그인 iOS 클라이언트 ID — GoogleSignIn SDK가 직접 읽는다 -->
	<key>GIDClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<!-- 로그인 후 앱으로 돌아올 때 쓰는 스킴. iOS 클라이언트 ID를 점 기준으로 뒤집은 값이다 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_IOS_CLIENT_ID_REVERSED)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
