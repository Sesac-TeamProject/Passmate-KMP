TEAM_ID=

// 코드 서명 팀. 맥마다 다르므로 Local.xcconfig에서 덮어쓴다 (bundle id에 붙는 TEAM_ID와 별개다)
DEVELOPMENT_TEAM_ID=W345THX6Y6

PRODUCT_NAME=Passmate
PRODUCT_BUNDLE_IDENTIFIER=org.sesacteamproject.passmate.Passmate$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// 백엔드 주소(호스트[:포트]). 스킴은 코드에서 붙인다 — xcconfig는 `//`를 주석으로 읽는다.
// 기본값은 운영 서버다 — 포트를 적지 않아 https 기본 포트(443)로 간다. 로컬 백엔드를 볼
// 때만 소스를 고치지 말고 Local.xcconfig(gitignore)에 `PASSMATE_SERVER_HOST=localhost:8080`
// 또는 `PASSMATE_SERVER_HOST=192.168.0.10:8080`(실기기용 맥 LAN 주소)을 적어 덮어쓴다.
PASSMATE_SERVER_HOST=api.passmate.kr

// 구글 로그인 iOS 클라이언트 ID. `806...-xxxx.apps.googleusercontent.com` 형태이고,
// REVERSED는 그 값을 점 기준으로 뒤집은 `com.googleusercontent.apps.806...-xxxx`다.
// 클라이언트 ID는 비밀이 아니라 앱에 박히는 값이라 여기에 둔다(비밀은 백엔드의 client secret뿐이다).
GOOGLE_IOS_CLIENT_ID=806560773397-rg6k3fks585etkqec0jnks2cmg27poq3.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID_REVERSED=com.googleusercontent.apps.806560773397-rg6k3fks585etkqec0jnks2cmg27poq3

#include? "Local.xcconfig"
