TEAM_ID=

PRODUCT_NAME=Passmate
PRODUCT_BUNDLE_IDENTIFIER=org.sesacteamproject.passmate.Passmate$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// 백엔드 주소(호스트:포트). 스킴은 코드에서 붙인다 — xcconfig는 `//`를 주석으로 읽는다.
// 기본값은 시뮬레이터용. 실기기 테스트는 소스를 고치지 말고 Local.xcconfig(gitignore)에
// `PASSMATE_SERVER_HOST=192.168.0.10:8080` 처럼 맥의 LAN 주소를 적어 덮어쓴다.
PASSMATE_SERVER_HOST=localhost:8080

#include? "Local.xcconfig"
